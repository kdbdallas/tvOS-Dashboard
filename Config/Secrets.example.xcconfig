// Copy this file to Config/Secrets.xcconfig and fill in the OAuth client you
// created in Google Cloud Console (type: "TVs and Limited Input devices").
// Config/Secrets.xcconfig is gitignored, so your values stay local.

GOOGLE_CLIENT_ID = 1234567890-abcdefghijklmnop.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET = GOCSPX-your-client-secret
